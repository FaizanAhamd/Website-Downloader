# ============================================================
# Website Downloader — Example environment variables
# Copy this file to `.env` and fill in real values locally.
# Never commit `.env` (it is gitignored).
# ============================================================

# --- HTTP server ---
PORT=3000

# --- Public branding (safe to expose) ---
PUBLIC_PRODUCT_NAME=Website Downloader
PUBLIC_PRODUCT_OWNER=Faizan Ahmad
PUBLIC_GITHUB_URL=https://github.com/FaizanAhamd/Website-Downloader

# Optional. Leave empty to hide the block in the UI.
PUBLIC_CONTACT_EMAIL=
PUBLIC_BUSINESS_ADDRESS=

# Optional. Set once a real domain exists (used for canonical/OG).
PUBLIC_SITE_URL=

# --- Download engine ---
DOWNLOAD_QUOTA=100m
DOWNLOAD_TIMEOUT_MS=300000
DOWNLOAD_WATCHDOG_MS=2000
MAX_CONCURRENT_DOWNLOADS=5
DOWNLOAD_ZIP_TTL_HOURS=24

# Optional. Overrides the wget binary path (e.g. on Windows with bundled exe).
WGET_PATH=

# --- Future Vercel deployment (documented, not used yet) ---
# VERCEL_WORKER_API_URL=
# ZIP_STORAGE_BUCKET=
