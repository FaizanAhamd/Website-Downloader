<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />

<link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet">

    <script src="/socket.io/socket.io.js"></script>
<!-- Place this tag in your head or just before your close body tag. -->
<script async defer src="https://buttons.github.io/buttons.js"></script>


  </head>
  <body>
    {{{body}}}
  </body>
<!-- Global site tag (gtag.js) - Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=UA-120895783-4"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'UA-120895783-4');
</script>
<script>
  var numberOfFiles = 0;
  var sessionToken = '';
  var downloadWebsite = document.getElementsByClassName('btn-success')[0];
  var downloadBtn = document.getElementById('download');
  var websiteInput = document.getElementById('website');
  var progressBar = document.getElementById('progress');
  var filesLine = document.getElementById('nFilesP');
  var filesCount = document.getElementById('nFiles');
  var log = document.getElementById('log');
  var connStatus = document.getElementById('connStatus');

  // Safe storage: falls back to an in-memory token if localStorage is blocked.
  function getToken() {
    try {
      var t = localStorage.getItem('token');
      if (!t) { t = generateToken(20); localStorage.setItem('token', t); }
      return t;
    } catch (e) {
      if (!sessionToken) sessionToken = generateToken(20);
      return sessionToken;
    }
  }

  function showConnecting() {
    if (!connStatus) return;
    connStatus.hidden = false;
    connStatus.textContent = 'Connecting to server…';
    downloadBtn.disabled = true;
  }
  function showConnected() {
    if (!connStatus) return;
    connStatus.hidden = true;
    downloadBtn.disabled = false;
  }
  function showDisconnected() {
    if (!connStatus) return;
    connStatus.hidden = false;
    connStatus.textContent = 'Connection lost. Retrying…';
    downloadBtn.disabled = true;
  }

  var socket = io.connect(document.URL, { reconnection: true });
  socket.on('connect', showConnected);
  socket.on('connect_error', showDisconnected);
  socket.on('disconnect', showDisconnected);
  showConnecting();

  // Reliable file counting: wget prints one line containing ' -> "' per saved
  // file. We buffer partial lines across socket chunks so split lines are not
  // miscounted (the old "200 OK" string search was unreliable).
  var lineBuf = '';
  function countSavedFiles(chunk) {
    lineBuf += chunk;
    var lines = lineBuf.split('\n');
    lineBuf = lines.pop();
    var n = 0;
    for (var i = 0; i < lines.length; i++) {
      if (lines[i].indexOf(' -> "') !== -1) n++;
    }
    return n;
  }

  socket.on(getToken(), function (event) {
    if (event && event.error) {
      progressBar.hidden = true;
      log.textContent = '';
      var failure = document.createElement('strong');
      failure.style.color = '#c0392b';
      failure.textContent = event.error;
      log.appendChild(failure);
      downloadBtn.disabled = false;
      return;
    }

    progressBar.hidden = false;

    if (event.progress === 'Starting') {
      filesLine.hidden = true;
      log.textContent = 'Starting download…';
    } else if (event.progress === 'Converting') {
      log.textContent = '100%! Compressing your website...';
    } else if (event.progress === 'Completed') {
      progressBar.hidden = true;
      log.textContent = 'Compressing completed successfully !';
      if (typeof event.files === 'number') filesCount.textContent = event.files;
      downloadWebsite.style.display = '';
      downloadWebsite.onclick = function () {
        window.location = '/sites/' + event.file + '.zip';
      };
      downloadBtn.disabled = false;
    } else {
      numberOfFiles += countSavedFiles(event.progress);
      filesLine.hidden = false;
      filesCount.textContent = numberOfFiles;
      log.textContent = event.progress;
    }
  });

  function startDownload() {
    var website = websiteInput.value;
    if (!website.trim()) return;
    numberOfFiles = 0;
    filesCount.textContent = '0';
    log.textContent = '';
    downloadWebsite.style.display = 'none';
    downloadBtn.disabled = true;
    socket.emit('request', { token: getToken(), website: website });
  }
  downloadBtn.onclick = startDownload;

  document.getElementById('downloadForm').addEventListener('submit', function (e) {
    e.preventDefault();
    startDownload();
  });

  function generateToken(n) {
    var chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    var token = '';
    for (var i = 0; i < n; i++) {
      token += chars[Math.floor(Math.random() * chars.length)];
    }
    return token;
  }
</script>
</script>


</html>

