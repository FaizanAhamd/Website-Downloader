                <button class="btn btn-info btn-lg" id="download" type="button" aria-label="Download website">
                  <img src="https://img.icons8.com/?size=100&id=42798&format=png&color=FFFFFF"
                       width="22" height="22" alt="">
                </button>
              </span>
            </div>
          </form>
        </div>
      </div>
    </div>

    <h5 hidden id="nFilesP">Total Downloaded file: <span id="nFiles" style="color: red;font-weight: bold">0</span></h5>
    <p class="log" id="log" aria-live="polite"></p>
    <button style="display: none" class="btn btn-success">Download website assets</button>
  </div>
</main>
