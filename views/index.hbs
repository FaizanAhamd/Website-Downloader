<header>
  <div aria-busy="true" id="progress" hidden aria-label="Loading, please wait." role="progressbar"></div>
</header>
<main role="main">
  <div id="connStatus" hidden style="background:#fff3cd;color:#856404;padding:8px 12px;border-radius:4px;margin-bottom:12px;font-weight:600;width:100%;max-width:640px;"></div>

  <img src="https://img.icons8.com/?size=100&id=42798&format=png&color=000000" width="100" alt="Website Downloader icon" />
  <h1>Website Downloader</h1>
  <p>Download mirrorable static pages and assets of any public website.</p>

  <div class="container">
    <div class="row">
      <div class="col-lg-12" style="float: none; margin: 0 auto;">
        <div id="custom-search-input">
          <form class="form" id="downloadForm" novalidate>
            <div class="input-group col-md-12">
              <label class="sr-only" for="website">Website URL</label>
              <input
                type="url"
                class="form-control input-lg"
                id="website"
                placeholder="https://example.com"
                required
                maxlength="2048"
                aria-label="Website URL"
              />
